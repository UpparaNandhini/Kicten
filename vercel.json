{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/customer",
      "destination": "/customer.html"
    },
    {
      "source": "/kitchen",
      "destination": "/kitchen.html"
    },
    {
      "source": "/book",
      "destination": "/index.html"
    },
    {
      "source": "/menu",
      "destination": "/index.html"
    }
  ]
}
